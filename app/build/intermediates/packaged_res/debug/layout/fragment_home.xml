<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ================= TOP BAR ================= -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnProfile"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:text="W"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_badge"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_online" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/status_online"
                android:textColor="#B8A9E0"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnPermissions"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="@color/text_secondary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/nav_settings" />
    </LinearLayout>

    <!-- ================= CENTER STAGE ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <com.toco.ai.ui.widget.OrbView
            android:id="@+id/orbView"
            android:layout_width="@dimen/orb_size"
            android:layout_height="@dimen/orb_size"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/orb_idle" />

        <TextView
            android:id="@+id/tvGreeting"
            style="@style/Text.Greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/tvSubGreeting"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sub_greeting" />

        <TextView
            android:id="@+id/tvOrbState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/orb_idle"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/commandBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_command_bar"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <EditText
                android:id="@+id/etCommand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/command_hint"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:importantForAutofill="no" />

            <ImageView
                android:id="@+id/btnMic"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_marginEnd="16dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/text_secondary"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/voice_prompt" />

            <ImageView
                android:id="@+id/btnSend"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@android:drawable/ic_input_add"
                android:tint="@color/text_secondary"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/command_hint" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
