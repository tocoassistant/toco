<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Toco" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Theme.Toco.Splash" parent="Theme.Toco">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Text.Greeting" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Secondary" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.NavLabel" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <!-- The assist activity starts listening and finishes; it must never be
         seen, or the assist gesture would flash a blank screen. -->
    <style name="Theme.Toco.Invisible" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- The listening screen floats over whatever is behind it. -->
    <style name="Theme.Toco.Transparent" parent="Theme.Toco">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
