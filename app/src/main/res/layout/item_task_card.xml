<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_task_card" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/taskState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending" android:textColor="@color/accent_light" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/taskTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_hint" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:id="@+id/taskText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_primary" android:textSize="15sp"/>
    <LinearLayout android:id="@+id/taskActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="end">
        <TextView android:id="@+id/taskCancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="Cancel" android:textColor="@color/text_secondary" android:textStyle="bold"/>
        <TextView android:id="@+id/taskDone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="Done" android:textColor="@color/accent_light" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
