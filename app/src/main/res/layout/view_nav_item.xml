<?xml version="1.0" encoding="utf-8"?>
<!--
    One bottom-nav item. The ring sits BEHIND the icon and is scaled up +
    faded in when this tab becomes active, so the raised circle appears to
    move to whichever tab you pick. clipChildren="false" is what lets the
    ring overflow its 40dp box instead of being cut off.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="14dp"
    android:paddingBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/navContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:layout_width="@dimen/nav_ring_size"
            android:layout_height="@dimen/nav_ring_size"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/navRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_ring" />

            <ImageView
                android:id="@+id/navIcon"
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/navLabel"
            style="@style/Text.NavLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
